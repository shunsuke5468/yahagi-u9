{
  "rules": {
    "editKey": {
      ".read": false,
      ".write": false
    },
    "editors": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.val() === root.child('editKey').val()"
      }
    },
    "$top": {
      ".read": true,
      ".write": "auth != null && root.child('editors').child(auth.uid).exists()",
      "attendance": {
        "$tid": {
          "$name": {
            ".write": true,
            ".validate": "!newData.exists() || newData.hasChildren()"
          }
        }
      },
      "live": {
        "cheers": {
          "$kind": {
            ".write": "data.parent().parent().exists()",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999"
          }
        }
      }
    }
  }
}
